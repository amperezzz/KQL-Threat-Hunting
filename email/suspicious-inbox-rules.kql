// Suspicious inbox rules: rules that delete, hide, forward or move mail (common after BEC account takeover)
// MITRE ATT&CK: T1564.008 (Hide Artifacts: Email Hiding Rules)
// Table: CloudAppEvents (Microsoft Defender XDR advanced hunting)
let lookback = 7d;
let suspiciousActions = dynamic(["DeleteMessage", "MoveToFolder", "MarkAsRead", "ForwardTo", "RedirectTo", "ForwardAsAttachmentTo"]);
let suspiciousFolders = dynamic(["RSS", "Archive", "Conversation History", "Junk", "Deleted Items"]);
CloudAppEvents
| where Timestamp > ago(lookback)
| where ActionType in ("New-InboxRule", "Set-InboxRule", "UpdateInboxRules")
| extend Params = tostring(RawEventData.Parameters)
| where Params has_any (suspiciousActions) or Params has_any (suspiciousFolders)
| project
    Timestamp,
    AccountDisplayName,
    AccountObjectId,
    ActionType,
    IPAddress,
    CountryCode,
    Params
| order by Timestamp desc
// Follow-up: correlate with risky or unusual sign-ins for the same account in the hours before the rule was created
