// Password spray: one IP failing sign-ins across many different accounts
// MITRE ATT&CK: T1110.003 (Password Spraying)
// Table: SigninLogs (Microsoft Sentinel / Log Analytics)
// 50126 = invalid username or password, 50053 = account locked
let lookback = 1d;
let minTargetedUsers = 10;
SigninLogs
| where TimeGenerated > ago(lookback)
| where ResultType in ("50126", "50053")
| summarize
    TargetedUsers = dcount(UserPrincipalName),
    FailedAttempts = count(),
    SampleUsers = make_set(UserPrincipalName, 25),
    Apps = make_set(AppDisplayName, 10)
    by IPAddress, bin(TimeGenerated, 1h)
| where TargetedUsers >= minTargetedUsers
| order by TargetedUsers desc
