// Users who clicked links in emails flagged as phishing
// MITRE ATT&CK: T1566.002 (Phishing: Spearphishing Link)
// Tables: UrlClickEvents, EmailEvents (Microsoft Defender XDR advanced hunting)
let lookback = 7d;
let PhishEmails = EmailEvents
    | where Timestamp > ago(lookback)
    | where ThreatTypes has "Phish"
    | project NetworkMessageId, SenderFromAddress, Subject, DeliveryAction;
UrlClickEvents
| where Timestamp > ago(lookback)
| join kind=inner PhishEmails on NetworkMessageId
| project
    Timestamp,
    AccountUpn,
    Url,
    ActionType,
    IsClickedThrough,
    SenderFromAddress,
    Subject,
    DeliveryAction,
    IPAddress
| order by Timestamp desc
// Prioritize rows where IsClickedThrough == true or ActionType == "ClickAllowed"
